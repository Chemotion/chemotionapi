{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "chemotion://generic/select_option/draft-01",
    "title": "Schema for generic selection options",
    "type": "object",
    "additionalProperties": {
        "type": "object",
        "properties": {
            "options": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "key": {
                            "type": [
                                "string",
                                "number",
                                "boolean",
                                "null"
                            ]
                        },
                        "label": {
                            "type": [
                                "string",
                                "number",
                                "boolean",
                                "null"
                            ]
                        },
                        "desc": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "key",
                        "label"
                    ]
                }
            },
            "desc": {
                "type": [
                    "string",
                    "null"
                ]
            }
        },
        "additionalProperties": false,
        "required": [
            "options"
        ]
    }
}