# The server this release line tests against.
#
# compose.yml deliberately declares no default images: a stack that silently brings up the wrong
# server produces failures that look like client bugs. Something therefore has to supply them,
# and it cannot be the caller's shell — conftest.py runs tests/data/setup_chemotion_db.sh
# directly, and that script invokes docker compose itself. This file is that something; every
# caller passes it with --env-file.
#
# This is the 312.x line, so it pins ELN 3.1.2. The 400.x line overrides these with the v4
# images, pinned by digest — see README.md.
CHEMOTION_ELN_IMAGE=ptrxyz/chemotion:eln-3.1.2
CHEMOTION_DB_IMAGE=ptrxyz/chemotion:db-3.1.2
