# The server this release line tests against. compose.yml deliberately declares no defaults, so
# that a stack can never silently bring up the wrong ELN; this file is where the 400.x line
# supplies them. The 312.x line ships its own values — see README.md for both.
#
# IMAGES ARE PINNED BY DIGEST ON PURPOSE. `next-release` is a rolling tag, rebuilt whenever the
# v4 branch moves, and Docker Hub publishes no immutable v4 tag (its tags jump from v3.1.1
# straight to next-release). Without the digest, two runs a day apart can test different servers.
# Bumping a digest is a deliberate, reviewed change: record the new digest together with the
# `Version:` string that /about then reports.
#
# Pinned 2026-08-21:
#   eln  next-release      -> v4.0.0-rc-260818
#   db   postgres16-rdkit  -> Postgres 16 + RDKit cartridge, the image the ELN's own CI uses
CHEMOTION_ELN_IMAGE=complat/chemotion_eln_stage:next-release@sha256:3520ac2cf46301f53eddf68b58971ca74ca8a2dd331c96765cad02c13b021343
CHEMOTION_DB_IMAGE=complat/dev:postgres16-rdkit@sha256:326d2ef0ee96cc7a8da7569a1637b1527abaa9cd0c1c680b7320223febfd254c

# Keeps this line's volumes apart from the other line's, which survive `docker compose down`.
CHEMOTION_STACK_SUFFIX=v4
